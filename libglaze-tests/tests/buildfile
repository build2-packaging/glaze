import libs = libglaze%lib{glaze}
import asio = libasio%lib{asio}
import eigen = Eigen%lib{Eigen}

define json: file
json{*}: extension = json

# Unit tests.
#
exe{*}:
{
  test = true
  install = false
}

# skip: erlang (sys-lib) & lib_test (just annoying setup)
for [dir_path] d: tests/{*_test*/ \
                          -eetf_test/ \
                          -key_transformers_test/ \
                          -lib_test/ \
                        } \
                  tests/{ \
                          *_conformance/ \
                          *_parsing/ \
                          *_performance/ \
                          *_repe/ \
                          *_formats/ \
                        }
{
  n = $string($leaf($d))
  for t: tests/$n/cxx{*}
  {
    tn = $name($t)
    exe{$n-$tn}: ut/hxx{ut} tests/$n/hxx{*} tests/$n/cxx{$tn} \
                 tests/$n/json{**} $libs testscript
    # Don't build (and test/run) benchmarks by default.
    ./: exe{$n-$tn}: include = (!$contains($n, 'performance'))
  }
}

# asio_repe
exe{tests-asio_repe-asio_repe}: $asio

# roundtrip
for [string] f : json beve # toml
{
  n = roundtrip
  t = $(n)-$(f)_test
  ./: exe{$t}: ut/hxx{ut} tests/$n/json{**} tests/$n/obj{$t} testscript
  tests/$n/obj{$t}: ut/hxx{ut} tests/$n/hxx{*} tests/$n/cxx{*} $libs
  {
    cxx.poptions += "-I$src_base" "-DGLZ_TEST_FORMAT=glz::$string.ucase($f)"
  }
  tests/$n/obj{$t}: ut/hxx{ut} tests/$n/hxx{*} tests/$n/cxx{*} $libs
}

# Build options.
#
cxx.poptions += "-I$src_base"

for c : tests/cxx{**}
{
  d = $directory($c)
  n = $name($c)
  td = [path] $src_base/$d
  $d/obj{$n}: \
    cxx.poptions += \
      "-DGLZ_TEST_DIRECTORY=\"$path.posix_representation($td)\""
}

# eigen_test
exe{eigen_test-eigen_test}: $eigen

# tests requiring certain compiler features
if ($cxx.id != 'msvc')
{
  tests/asio_repe/obj{*}: \
    cxx.coptions += -DASIO_HAS_CO_AWAIT -DASIO_HAS_STD_COROUTIN

  for [dir_path] d : tests/{ \
                       buffer_pool_test \
                       exceptions_test \
                       json_test \
                       json_performance \
                       inplace_vector \
                       int_parsing \
                       networking_tests \
                       threading_test \
                     }
  {
    tests/$name($d)/obj{**}: cxx.coptions += -fexceptions
  }
}

# Common build options.
#
# See: ../../upstream/tests/CMakeLists.txt
switch $cxx.id: path.match, $cxx.target.system: path.match
{
  case 'gcc' | 'clang*'
  {
    cxx.coptions += \
      -fno-rtti \
      -fno-exceptions \
      -Wno-missing-braces
  }
  case 'gcc', 'mingw32'
  {
    cxx.coptions += \
      -Wa,-mbig-obj
  }
  case 'msvc' | 'msvc-clang', 'win32-msvc'
  {
    cxx.coptions += \
      /permissive- \
      /bigobj \
      /GR- \
      /wd4459 \
      /wd4805 \
      /Zc:lambda \
      /Zc:preprocessor
  }
}

if ($cxx.target.system == 'win32-msvc')
{
  cxx.coptions += -DNOMINMAX
}
