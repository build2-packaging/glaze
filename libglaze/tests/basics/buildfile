import libs = libglaze%lib{glaze}

exe{driver}: {hxx cxx}{**} $libs testscript

switch $cxx.id: path.match
{
  case 'gcc' | 'clang*'
  {
    cxx.coptions += -Wno-missing-braces
  }
  case 'msvc'
  {
    cxx.coptions += \
      /Zc:preprocessor \
      /wd4459 \
      /wd4805
  }
}

# glaze/file/file_ops.hpp only silences the CRT fopen() deprecation for MSVC
# proper, not for Clang targeting MSVC.
#
if ($cxx.target.system == 'win32-msvc')
  cxx.poptions += -D_CRT_SECURE_NO_WARNINGS
