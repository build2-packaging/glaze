: 1
name: libglaze
version: 8.4.0-a.0.z
type: lib,binless
language: c++
project: glaze
summary: JSON and interface library for C++
topics: json, json rpc 2.0, csv, beve, serialization
license: MIT ; MIT License.
description-file: README.md
package-description-file: PACKAGE-README.md
url: https://github.com/stephenberry/glaze
doc-url: https://stephenberry.github.io/glaze
email: stephenberry.developer@gmail.com
package-url: https://github.com/build2-packaging/glaze
package-email: packaging@build2.org ; Mailing list.
requires: c++23
depends: * build2 >= 0.18.0
depends: * bpkg >= 0.18.0
depends: libasio ^1.29.0 ? ($config.libglaze.repe_rpc)
tests: libglaze-tests == $
builds: default experimental               ; Only modern compilers are supported.
builds: &( +gcc-13+ +clang-18+ +msvc-18+ ) ; Requires newer features & bug-fixes.
build-exclude: linux_*-clang_18    ; Clang 18 lacks std::expected with libstdc++.
build-exclude: linux_*-clang_18-** ; Clang 18 lacks std::expected with libstdc++.
build-exclude: linux_debian_12-gcc_14    ; GCC 14.1 ICE and TOML test crashes.
build-exclude: linux_debian_12-gcc_14-** ; GCC 14.1 ICE and TOML test crashes.
